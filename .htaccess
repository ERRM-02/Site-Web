# Spécifie que le fichier par défaut à charger est index.html
DirectoryIndex index.html

# Redirection automatique vers HTTPS
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# URLs propres : servir savoir-faire.html quand on demande /savoir-faire
# Condition : le fichier .html existe, mais pas de fichier/dossier sans extension
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>
